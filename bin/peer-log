#!/usr/bin/env python3
"""Thin entrypoint for peer-log (#7): the implementation is aipairlib.peerlog. Adds its own
directory to sys.path so `from aipairlib import peerlog` finds the sibling package."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from aipairlib import peerlog

if __name__ == "__main__":
    sys.exit(peerlog.main())
