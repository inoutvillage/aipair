#!/usr/bin/env python3
"""aipair-queue — キューファイルのタスクを aipair ペアで1件ずつ全自動処理する orchestrator.

流れ（1タスク = 1 relay = 1 PR = 1 マージ）:
  queue.md の次の `- [ ]` タスクを取得
    → git を main 最新に整える
    → aipair-relay (--adopt) を子プロセスで起動
    → Claude ペインへタスクを注入（実装 → 検証 → PR 作成まで Claude が行う）
    → relay が停止ワード（完了です）で終了するのを待つ（exit 0 のみ成功）
    → PR の CI (required checks) が green になるのを待つ
    → prisma/migrations/ を含む PR は、allowlist 検査（追加系 SQL のみ許可）を通してから
      マージ前に本番 DB へ `prisma migrate deploy`
      （main マージ = Vercel 本番デプロイだが、migration は自動適用されない実績バグのため）
    → gh pr merge --merge → queue.md を `- [x]` に更新 → 次のタスクへ

異常（relay キャップ/poke失敗・PR 未作成・CI red・migrate 失敗・タイムアウト）は
そのタスクを `- [!] 要人間:` にマークして保留し、次のタスクへ進む。
ただし連続 N 回（既定3）異常が続いたら同一原因の空回りとみなしキュー全体を停止する。

Maintainer decision: マージは migration 含め全自動 / 異常タスクはスキップして次へ。
relay-here の「1回=1relay・無限ループにしない」原則は維持 — これはキュー分だけの
有限ループで、キューが尽きれば終了する（常駐デーモンではない）。

キューファイル形式 (markdown checklist):
  - [ ] やってほしいこと（1行1タスク。この行がそのまま Claude への指示になる）
  - [>] 処理中（queue が自動でマーク）
  - [x] 完了 — PR #N merged（同上）
  - [!] 要人間: 理由（同上。保留。人間が対応後 `- [ ]` に戻せば再投入される）

使い方（bridge ペインで直接実行）:
  aipair-queue [queue.md]                # 既定: <dir>/tasks/queue.md
    [--dir D] [--session S] [--max-tasks N] [--rounds N] [--stop PHRASE]
    [--task-timeout MIN] [--ci-timeout MIN] [--max-consecutive-failures N]
    [--no-merge] [--dry-run]
"""
import argparse
import ipaddress
import socket
import importlib.machinery
import importlib.util
import os
import re
import signal
import subprocess
import sys
import time
from urllib.parse import parse_qs, unquote, urlsplit

_HERE = os.path.dirname(os.path.realpath(__file__))
RELAY = os.path.join(_HERE, "aipair-relay")
_loader = importlib.machinery.SourceFileLoader("relay", RELAY)
_spec = importlib.util.spec_from_loader("relay", _loader)
relay = importlib.util.module_from_spec(_spec)
_loader.exec_module(relay)  # __name__ != "__main__" なので relay の main() は走らない

C = relay.C


def c(key, s):
    return relay.c(key, s)


def log(s):
    print(c("relay", "┃ ") + s, flush=True)


def warn(s):
    print(c("warn", "┃ ■ " + s), flush=True)
    print("\a", end="", flush=True)


def ok(s):
    print(c("ok", "┃ ✔ " + s), flush=True)


TASK_RE = re.compile(r"^- \[ \] (.+?)\s*$")

RELAY_EXIT = {3: "最大往復キャップ到達（膠着の可能性）", 4: "poke 配達失敗",
              5: "プランレビュー上限/選択肢欠落", 6: "停止ゲート失敗（テスト等が通らない）",
              130: "手動中断"}


def task_prompt(task, i, total):
    return (f"【aipair-queue 自動投入 {i}/{total}】次のタスクに対応してください: {task} "
            f"進め方: main から作業ブランチを切って実装し、検証（typecheck・関連テスト）まで通したら "
            f"commit / push して gh で PR を作成してください（PR 本文に検証結果を記載）。"
            f"完了したら PR 番号を明記してターンを終えてください。あなたの返答は自動で Codex に共有され"
            f"レビュー往復が始まります。マージとその後の処理はキューが自動で行うので、"
            f"人間への確認・伝言は不要です。")


# --- queue file ------------------------------------------------------------- #
def next_task(path):
    """(元行, タスク本文) を返す。ユーザーが随時追記できるよう毎回読み直す。"""
    try:
        for line in open(path, encoding="utf-8"):
            m = TASK_RE.match(line.rstrip("\n"))
            if m:
                return line.rstrip("\n"), m.group(1)
    except OSError as e:
        warn(f"キューファイルを読めない: {e}")
    return None, None


def remaining(path):
    try:
        return sum(1 for l in open(path, encoding="utf-8") if TASK_RE.match(l.rstrip("\n")))
    except OSError:
        return 0


def rewrite_line(path, old_line, new_line):
    """行内容一致で1行だけ書き換える（ユーザーの同時編集で行番号がずれても安全）。"""
    try:
        lines = open(path, encoding="utf-8").read().splitlines(keepends=False)
    except OSError as e:
        warn(f"キューファイルを読めない: {e}")
        return False
    for i, l in enumerate(lines):
        if l == old_line:
            lines[i] = new_line
            tmp = path + ".tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                fh.write("\n".join(lines) + "\n")
            os.replace(tmp, path)
            return True
    warn(f"キュー内で行が見つからずマークできない（ユーザー編集と衝突？）: {old_line}")
    return False


# --- subprocess helpers ------------------------------------------------------ #
def run(cmd, cwd, timeout=None, env=None, capture=True):
    """returncode, stdout(text) を返す。例外は握らず (rc=-1, メッセージ) に正規化。"""
    try:
        p = subprocess.run(cmd, cwd=cwd, timeout=timeout, env=env, text=True,
                           capture_output=capture)
        return p.returncode, (p.stdout or "") + (p.stderr or "")
    except subprocess.TimeoutExpired:
        return -1, f"timeout: {' '.join(cmd)}"
    except OSError as e:
        return -1, f"exec error: {e}"


def git(args, cwd, **kw):
    return run(["git", *args], cwd, **kw)


def gh(args, cwd, **kw):
    return run(["gh", *args], cwd, **kw)


def gh_retry(args, cwd, attempts=3, wait=10, **kw):
    """読み取り系 gh 呼び出しの一時失敗（GitHub 5xx・ネットワーク）を吸収する。
    ※ `pr checks --watch` には使わない（非0 = CI 失敗であり再試行対象でない）。"""
    rc, out = -1, ""
    for i in range(attempts):
        rc, out = gh(args, cwd, **kw)
        if rc == 0:
            return rc, out
        if i < attempts - 1:
            time.sleep(wait)
    return rc, out


# --- git 整地 ---------------------------------------------------------------- #
def to_main(cwd):
    rc, out = git(["checkout", "main"], cwd)
    if rc != 0:
        return False, f"checkout main 失敗: {relay.oneline(out)}"
    rc, out = git(["pull", "--ff-only", "origin", "main"], cwd, timeout=120)
    if rc != 0:
        return False, f"pull 失敗: {relay.oneline(out)}"
    return True, ""


def stash_if_dirty(cwd, label):
    # tracked の変更のみ退避する。-u を付けると常駐 untracked（.vscode/ や _reference/ =
    # 大容量・PII 可能性のある人間の資料置き場）まで作業ツリーから巻き込むため使わない。
    # タスクが作った新規 untracked が残っても checkout main は妨げない。
    rc, out = git(["status", "--porcelain", "-uno"], cwd)
    if rc == 0 and out.strip():
        git(["stash", "push", "-m", f"aipair-queue: {label}"], cwd)
        log(f"未コミット変更（tracked）を stash に退避（aipair-queue: {label}）")


# --- migration allowlist ------------------------------------------------------ #
# A safety gate BEFORE `prisma migrate deploy` (destructive, applied to prod before the
# code ships). Only additive, expand-safe statements pass; ANYTHING else — DROP, RENAME,
# SET NOT NULL, type change, TRUNCATE, DML, a required column with no default, or SQL we
# cannot parse — is refused and the task is held for a human. This runs regardless of the
# D2 decision on where the queue lives (see tasks/decisions.md). --allow-unsafe-migrations
# skips it for a maintainer who has reviewed the SQL by hand.
# A stateful SQL lexer, not regexes: comment/quote markers hidden inside a literal must not
# fool the gate, and each allowed form is matched to its END (not by prefix), so a valid but
# unsupported tail (CREATE TABLE ... DROP ...) or a missing piece (ADD VALUE with no value) is
# rejected. Statements become normalized token lists: 'strings' → <STR>, "idents" → <IDENT>,
# numbers → <NUM>, comments gone, else an UPPERCASED bareword or one punctuation char.
# Unterminated / nested-unbalanced comments and unterminated quotes raise → reject.
_WORD_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_$]*")
_NUM_RE = re.compile(r"[0-9][0-9.]*")
_DOLLAR_OPEN_RE = re.compile(r"\$[A-Za-z0-9_]*\$")
_BARE_NAME_RE = re.compile(r"[A-Z_][A-Z0-9_$]*")


def _lex_sql(sql):
    """[(tokens, raw_text)] per statement. Block comments nest (PostgreSQL); unterminated
    string / identifier / comment / dollar-quote raises ValueError → caller rejects."""
    i, n = 0, len(sql)
    stmts, toks, start = [], [], 0
    while i < n:
        ch = sql[i]
        if ch in " \t\r\n":
            i += 1
        elif sql.startswith("--", i):
            j = sql.find("\n", i); i = n if j < 0 else j + 1
        elif sql.startswith("/*", i):
            depth, i = 1, i + 2                       # PostgreSQL block comments nest
            while i < n and depth:
                if sql.startswith("/*", i):
                    depth += 1; i += 2
                elif sql.startswith("*/", i):
                    depth -= 1; i += 2
                else:
                    i += 1
            if depth:
                raise ValueError("unterminated block comment")
        elif ch == "'":
            i += 1
            while True:
                if i >= n:
                    raise ValueError("unterminated string literal")
                if sql[i] == "'":
                    if sql.startswith("''", i):
                        i += 2; continue
                    i += 1; break
                i += 1
            toks.append("<STR>")
        elif ch == '"':
            i += 1
            while True:
                if i >= n:
                    raise ValueError("unterminated quoted identifier")
                if sql[i] == '"':
                    if sql.startswith('""', i):
                        i += 2; continue
                    i += 1; break
                i += 1
            toks.append("<IDENT>")
        elif ch == "$" and _DOLLAR_OPEN_RE.match(sql, i):
            tag = _DOLLAR_OPEN_RE.match(sql, i).group(0)
            j = sql.find(tag, i + len(tag))
            if j < 0:
                raise ValueError("unterminated dollar-quoted string")
            i = j + len(tag); toks.append("<STR>")      # a dollar-quoted STRING literal (data)
        elif ch == ";":
            stmts.append((toks, sql[start:i])); toks = []; i += 1; start = i
        else:
            mw = _WORD_RE.match(sql, i)
            if mw:
                toks.append(mw.group(0).upper()); i = mw.end()
            else:
                mn = _NUM_RE.match(sql, i)
                if mn:
                    toks.append("<NUM>"); i = mn.end()
                else:
                    toks.append(ch); i += 1
    if toks or sql[start:].strip():
        stmts.append((toks, sql[start:]))
    return stmts


def _adjacent(toks, a, b):
    return any(toks[i] == a and toks[i + 1] == b for i in range(len(toks) - 1))


def _parens_balanced(toks):
    """Balanced () and []. (Both, so array types/defaults and index expressions count.)"""
    pairs = {")": "(", "]": "["}
    stack = []
    for t in toks:
        if t in ("(", "["):
            stack.append(t)
        elif t in (")", "]"):
            if not stack or stack.pop() != pairs[t]:
                return False
    return not stack


# barewords that can NOT stand in as an unquoted identifier in a name position
_NON_NAME = {"SELECT", "FROM", "WHERE", "TABLE", "TYPE", "INDEX", "DROP", "ALTER", "CREATE",
             "ADD", "COLUMN", "CONSTRAINT", "NOT", "NULL", "DEFAULT", "PRIMARY", "FOREIGN",
             "UNIQUE", "CHECK", "EXCLUDE", "VALUES", "VALUE", "INTO", "ON", "USING", "AS",
             "IF", "EXISTS", "ONLY", "CONCURRENTLY", "TO", "SET", "RENAME", "IS", "WITH",
             "SCHEMA", "VERSION", "CASCADE", "ENUM", "RANGE", "BEFORE", "AFTER"}
_CONSTRAINT_KW = {"CONSTRAINT", "PRIMARY", "FOREIGN", "UNIQUE", "CHECK", "EXCLUDE"}
_ACTION_VERBS = {"DROP", "ALTER", "RENAME", "SET"}   # must not appear inside a single ADD COLUMN


def _is_name_token(t):
    return t == "<IDENT>" or (bool(_BARE_NAME_RE.fullmatch(t)) and t not in _NON_NAME)


def _consume_name(toks, i):
    """A possibly schema-qualified name: <name> ( . <name> )*. Index after it, or None."""
    if i >= len(toks) or not _is_name_token(toks[i]):
        return None
    i += 1
    while i + 1 < len(toks) and toks[i] == "." and _is_name_token(toks[i + 1]):
        i += 2
    return i


def _match_group(toks, i):
    """toks[i] must be '('. Index just after the matching ')', or None if unbalanced."""
    if i >= len(toks) or toks[i] != "(":
        return None
    depth = 0
    for j in range(i, len(toks)):
        if toks[j] == "(":
            depth += 1
        elif toks[j] == ")":
            depth -= 1
            if depth == 0:
                return j + 1
    return None


def _split_actions(toks):
    """Top-level comma split, tracking () AND [] (array types/defaults). The final group is
    always emitted even when empty, so a trailing comma (…INTEGER,) yields an empty action
    that is then rejected."""
    groups, cur, depth = [], [], 0
    for t in toks:
        if t in ("(", "["):
            depth += 1; cur.append(t)
        elif t in (")", "]"):
            depth -= 1; cur.append(t)
        elif t == "," and depth == 0:
            groups.append(cur); cur = []
        else:
            cur.append(t)
    groups.append(cur)
    return groups


# Each validator consumes a conservative canonical form to the END; any residual token
# (e.g. a "DROP TABLE" glued after a balanced column list) is rejected.
def _ok_create_table(t):
    # CREATE TABLE [IF NOT EXISTS] <qname> ( … )   — nothing after the column list
    i = 2
    if t[i:i + 3] == ["IF", "NOT", "EXISTS"]:
        i += 3
    i = _consume_name(t, i)
    if i is None:
        return False
    j = _match_group(t, i)
    return j is not None and j == len(t)


def _ok_create_index(t):
    # CREATE [UNIQUE] INDEX [CONCURRENTLY] [IF NOT EXISTS] [<name>] ON <qname> [USING m] ( … )
    i = 1
    if t[i:i + 1] == ["UNIQUE"]:
        i += 1
    if t[i:i + 1] != ["INDEX"]:
        return False
    i += 1
    if t[i:i + 1] == ["CONCURRENTLY"]:
        i += 1
    if t[i:i + 3] == ["IF", "NOT", "EXISTS"]:
        i += 3
    if i < len(t) and t[i] != "ON":
        j = _consume_name(t, i)
        if j is None:
            return False
        i = j
    if t[i:i + 1] != ["ON"]:
        return False
    i = _consume_name(t, i + 1)
    if i is None:
        return False
    if t[i:i + 1] == ["USING"]:
        if i + 1 >= len(t) or not _is_name_token(t[i + 1]):
            return False
        i += 2
    j = _match_group(t, i)
    return j is not None and j == len(t)


def _ok_create_type(t):
    # CREATE TYPE <qname>            (shell type)
    # CREATE TYPE <qname> AS [ENUM|RANGE] ( … )
    i = _consume_name(t, 2)
    if i is None:
        return False
    if i == len(t):
        return True
    if t[i:i + 1] != ["AS"]:
        return False
    i += 1
    if t[i:i + 1] in (["ENUM"], ["RANGE"]):
        i += 1
    j = _match_group(t, i)
    return j is not None and j == len(t)


def _ok_create_extension(t):
    # CREATE EXTENSION [IF NOT EXISTS] <name> [WITH] [SCHEMA <name>] [VERSION <str>] [CASCADE]
    i = 2
    if t[i:i + 3] == ["IF", "NOT", "EXISTS"]:
        i += 3
    i = _consume_name(t, i)
    if i is None:
        return False
    while i < len(t):
        if t[i] == "WITH" or t[i] == "CASCADE":
            i += 1
        elif t[i] == "SCHEMA":
            i = _consume_name(t, i + 1)
            if i is None:
                return False
        elif t[i] == "VERSION" and t[i + 1:i + 2] in (["<STR>"], ["<IDENT>"]):
            i += 2
        else:
            return False
    return True


_COMMENT_KINDS = {"TABLE", "COLUMN", "INDEX", "TYPE", "SCHEMA", "EXTENSION", "CONSTRAINT",
                  "SEQUENCE", "VIEW", "DOMAIN", "FUNCTION", "TRIGGER", "DATABASE"}


def _ok_comment_on(t):
    # COMMENT ON <kind> <name…> IS ( <str> | NULL )   — value is the last token
    if len(t) < 4 or t[2] not in _COMMENT_KINDS or "IS" not in t:
        return False
    k = t.index("IS")
    return k >= 3 and t[k + 1:] in (["<STR>"], ["NULL"])


def _ok_alter_type_add_value(t):
    # ALTER TYPE <qname> ADD VALUE [IF NOT EXISTS] <str> [ (BEFORE|AFTER) <str> ]
    i = _consume_name(t, 2)
    if i is None or t[i:i + 2] != ["ADD", "VALUE"]:
        return False
    i += 2
    if t[i:i + 3] == ["IF", "NOT", "EXISTS"]:
        i += 3
    if t[i:i + 1] != ["<STR>"]:
        return False
    i += 1
    if i == len(t):
        return True
    if t[i] in ("BEFORE", "AFTER") and t[i + 1:i + 2] == ["<STR>"]:
        return i + 2 == len(t)
    return False


def _ok_add_column(act):
    """One ALTER TABLE action: ADD [COLUMN] [IF NOT EXISTS] <colname> <type> [constraints…].
    A column name AND a type are required; no nested action verb (DROP/ALTER/RENAME) may
    appear; NOT NULL needs a real DEFAULT (a required column with no default blocks rows)."""
    if not act or act[0] != "ADD":
        return False
    i, explicit = 1, False
    if act[i:i + 1] == ["COLUMN"]:
        explicit, i = True, i + 1
    if act[i:i + 3] == ["IF", "NOT", "EXISTS"]:
        i += 3
    if i >= len(act):
        return False
    if not explicit and act[i] in _CONSTRAINT_KW:      # ADD CONSTRAINT / PRIMARY KEY / … ≠ column
        return False
    if not _is_name_token(act[i]):                     # column name
        return False
    i += 1
    if i >= len(act) or not _is_name_token(act[i]):    # a type is required
        return False
    if _ACTION_VERBS & set(act):                       # e.g. "… DROP COLUMN old" glued on
        return False
    if _adjacent(act, "NOT", "NULL") and "DEFAULT" not in act:
        return False
    return _parens_balanced(act)


def _ok_alter_table(t):
    i = 2
    if t[i:i + 2] == ["IF", "EXISTS"]:
        i += 2
    if t[i:i + 1] == ["ONLY"]:
        i += 1
    i = _consume_name(t, i)
    if i is None:
        return False
    actions = _split_actions(t[i:])
    return bool(actions) and all(_ok_add_column(a) for a in actions)


# Statement-initiating / destructive verbs that never legitimately appear inside an
# additive DDL statement (ON DELETE/UPDATE use DELETE/UPDATE, so those are NOT here).
_DENY_TOKENS = {"DROP", "TRUNCATE", "INSERT", "GRANT", "REVOKE", "MERGE", "CALL", "DO",
                "EXECUTE", "COPY", "REINDEX", "VACUUM", "REFRESH"}


def _stmt_allowed(toks):
    if not toks:
        return True
    if not _parens_balanced(toks):
        return False
    if _DENY_TOKENS & set(toks):        # e.g. a DROP hidden inside "( … )" or a COMMENT target
        return False
    for i, t in enumerate(toks):        # DELETE/UPDATE only as "ON DELETE" / "ON UPDATE"
        if t in ("DELETE", "UPDATE") and (i == 0 or toks[i - 1] != "ON"):
            return False
    if _adjacent(toks, "SET", "NOT"):   # SET NOT NULL is an explicitly forbidden column change
        return False
    def starts(*w):
        return toks[:len(w)] == list(w)
    if starts("CREATE", "TABLE"):
        return _ok_create_table(toks)
    if starts("CREATE", "UNIQUE", "INDEX") or starts("CREATE", "INDEX"):
        return _ok_create_index(toks)
    if starts("CREATE", "TYPE"):
        return _ok_create_type(toks)
    if starts("CREATE", "EXTENSION"):
        return _ok_create_extension(toks)
    if starts("COMMENT", "ON"):
        return _ok_comment_on(toks)
    if starts("ALTER", "TYPE"):
        return _ok_alter_type_add_value(toks)
    if starts("ALTER", "TABLE"):
        return _ok_alter_table(toks)
    return False


def screen_migration_sql(sql):
    """(ok, offending): ok only if EVERY statement matches a supported additive form to its
    end. offending lists rejected statements (trimmed raw text) for the operator."""
    try:
        stmts = _lex_sql(sql)
    except ValueError as e:
        return False, [f"<<unparseable: {e}>>"]
    offending = []
    for toks, raw in stmts:
        if not toks:
            continue
        if not _stmt_allowed(toks):
            offending.append(" ".join(raw.split())[:160] or "<<empty>>")
    return (not offending), offending


# `prisma migrate status` wording we accept as "no pending migrations" (line-exact, not a
# substring — "…is not up to date!" must NOT count as up to date).
_UP_TO_DATE = {"database schema is up to date!", "no pending migrations to apply.",
               "no pending migrations found.", "no pending migrations."}
# Footer lines Prisma prints after the pending list. Two exact known shapes only: the
# instruction sentence, and the deploy command itself (optionally $-prefixed). A bare
# "$ <anything>" is NOT accepted — "$ prisma migrate reset --force" / "$ rm -rf /" must hold.
_FOOTER_INSTRUCTION = re.compile(
    r"to apply (the |this |these )?(pending )?migrations?"
    r"( in (production|development))? *,? *run"
    r"( the following command)?"
    r"( +(the +)?(npx +|yarn +|pnpm +)?prisma migrate (deploy|dev))?"   # dev instruction line too
    r" *[:.]?", re.I)
_FOOTER_COMMAND = re.compile(r"\$? *(npx +|yarn +|pnpm +)?prisma migrate deploy *\.?", re.I)


def _is_footer_line(line):
    return bool(_FOOTER_INSTRUCTION.fullmatch(line) or _FOOTER_COMMAND.fullmatch(line))


# A diagnostic/abnormal line. Anchored keywords ("ERROR:", "could not") plus known
# `migrate status` DB-state phrases (failed/diverged/drift/history) — all of which share
# rc=1 with a normal pending list, so the exit code alone can't tell them apart. Written as
# phrases (with spaces) so a migration NAME containing "failed" (…_add_failed_login) or a
# host "db-failover.example.com" is not falsely flagged.
_STATUS_ANOMALY = re.compile(
    r"(^\s*(error|warning|panic|fatal)\b"
    r"|\bcould not\b|\btruncat|\bnot up to date\b"
    r"|\bfailed migration|\bfound failed\b|\bdiverged\b|\bdrift detected\b"
    r"|\bmigration history\b|\bnot found locally\b|\bnot in a valid state\b)", re.I)
_MIG_NAME = re.compile(r"[0-9A-Za-z][0-9A-Za-z_.\-]*")
_PENDING_EXIT = 1                                    # `prisma migrate status` exits 1 when pending


def migrate_status_clean(rc, status_text):
    """True iff `migrate status` reports NO pending migrations: rc == 0, NO pending-list
    header, some line is an exact known up-to-date message, and NO anomaly anywhere."""
    if rc != 0:
        return False
    lines = [l.strip() for l in status_text.splitlines()]
    if any("not yet been applied" in l.lower() for l in lines):
        return False
    if any(_STATUS_ANOMALY.search(l) for l in lines):
        return False
    return any(l.lower() in _UP_TO_DATE for l in lines)


def parse_pending_migrations(rc, status_text):
    """Names of migrations `prisma migrate deploy` WOULD apply. ([], "") when up to date;
    (None, reason) whenever the output can't be understood (→ hold). Fail CLOSED: an
    abnormal exit code, ANY anomaly line, an unknown line in the name list, or a footer that
    is not an exact known form all hold. This is the real deploy set — screening only the
    PR diff would miss a pre-existing unapplied destructive migration that deploy also runs."""
    lines = status_text.splitlines()
    header = next((i for i, l in enumerate(lines) if "not yet been applied" in l.lower()), None)
    if header is None:
        if migrate_status_clean(rc, status_text):
            return [], ""
        return None, "migrate status を解釈できない（pending 判定不能）"
    if rc != _PENDING_EXIT:                           # pending の想定終了コード以外は保留
        return None, f"pending 一覧だが終了コードが想定外（rc={rc}）"
    # anomaly only on the NON-name lines (a migration name may contain "failed" etc.)
    if any(_STATUS_ANOMALY.search(l) for l in lines[:header]):
        return None, "migrate status のヘッダ前に異常/警告行がある"
    names, i = [], header + 1
    while i < len(lines) and lines[i].strip():
        line = lines[i].strip()
        if not _MIG_NAME.fullmatch(line):
            return None, f"pending 一覧に未知の行: {line[:60]!r}"
        names.append(line); i += 1
    for ln in lines[i:]:                              # after the list: only exact known footer
        s2 = ln.strip()
        if s2 and (_STATUS_ANOMALY.search(s2) or not _is_footer_line(s2)):
            return None, f"pending 一覧の後に未知/異常な行: {s2[:60]!r}"
    return (names, "") if names else (None, "pending header はあるが名前が無い")


def screen_pending_migrations(cwd, env):
    """Screen EVERY migration `migrate deploy` would apply (the pending set from the DB),
    reading each from the working tree (caller has checked out the pinned head). (ok, reason)."""
    rc, out = run(["npx", "prisma", "migrate", "status"], cwd, timeout=120, env=env)
    pending, why = parse_pending_migrations(rc, out)
    if pending is None:
        return False, f"{why}: {relay.oneline(out, 200)}"
    if not pending:
        return True, ""
    named = []
    for name in pending:
        path = os.path.join("prisma", "migrations", name, "migration.sql")
        full = os.path.join(cwd, path)
        try:
            with open(full, encoding="utf-8") as fh:      # strict UTF-8
                named.append((path, fh.read()))
        except UnicodeDecodeError:
            return False, f"pending migration {path} が UTF-8 でない（解析不能 → 保留）"
        except OSError as e:
            return False, f"pending migration {path} を読めない（{e}）"
    return screen_migration_texts(named)


def screen_migration_texts(named_sqls):
    """named_sqls: [(label, sql)]. (ok, reason) over all of them."""
    bad = []
    for label, sql in named_sqls:
        ok_, offending = screen_migration_sql(sql)
        if not ok_:
            bad.append(f"{label}: 非許可 SQL {offending[:3]}")
    if bad:
        return False, "migration allowlist 違反: " + " / ".join(bad)
    return True, ""


def pr_head_sha(num, cwd):
    """PR の head コミット SHA（headRefOid）。取得できなければ ""。"""
    rc, out = gh_retry(["pr", "view", num, "--json", "headRefOid", "--jq", ".headRefOid"], cwd)
    sha = out.strip()
    return sha if rc == 0 and re.fullmatch(r"[0-9a-f]{7,40}", sha) else ""


def checkout_detached(cwd, sha):
    """本番へ当てる直前に作業ツリーを PR head に固定する（検査した SQL と適用する SQL を一致させる）。"""
    git(["fetch", "origin", sha], cwd)                     # 念のため object を取得（既にあれば no-op）
    rc, out = git(["-c", "advice.detachedHead=false", "checkout", sha], cwd)
    return (rc == 0), relay.oneline(out, 200)


def _host_is_loopback(host):
    """One host token → a local target? Handles percent-encoding, a trailing dot, the RFC
    6761 *.localhost domain, IPv6, every IPv4 spelling (dotted / short a.b / 32-bit int),
    the unspecified address (0.0.0.0, ::) which reaches a local listener, and a decoded
    absolute path (PostgreSQL Unix-domain socket)."""
    if not host:
        return True
    host = unquote(host).strip()
    if host.startswith("/"):                    # Unix-domain socket directory → local
        return True
    host = host.strip("[]").rstrip(".").lower()
    if not host:
        return True
    if host == "localhost" or host.endswith(".localhost"):
        return True
    try:                                        # IPv6 / canonical IPv4: loopback or unspecified
        ip = ipaddress.ip_address(host)
        if ip.is_loopback or ip.is_unspecified:
            return True
    except ValueError:
        pass
    try:                                        # 127.1 / 2130706433 / 0 — short/int IPv4 forms
        if socket.inet_aton(host)[0] in (0, 127):   # 0.0.0.0/8 unspecified or 127.0.0.0/8 loopback
            return True
    except OSError:
        pass
    return False


def _url_is_loopback(url):
    """True if the URL points at a local target — any host in the (possibly multi-host,
    PostgreSQL-style) netloc, OR a ?host=/?hostaddr= query parameter (libpq lets these name
    a Unix-domain socket dir or an address, overriding the netloc host) — or if the host
    can't be determined (unsafe → treat as loopback)."""
    try:
        sp = urlsplit(url)
    except ValueError:
        return True
    # libpq/Prisma query params can redirect to a local socket / address regardless of netloc.
    # keep_blank_values: an empty host= selects the default Unix socket (local). Each value
    # may itself be a comma-separated multi-host list.
    q = parse_qs(sp.query, keep_blank_values=True)
    for key in ("host", "hostaddr"):
        for val in q.get(key, []):
            if any(_host_is_loopback(one) for one in val.split(",")):
                return True
    netloc = sp.netloc
    if "@" in netloc:
        netloc = netloc.rsplit("@", 1)[1]       # drop userinfo
    if not netloc:
        return True
    hosts = []
    for part in netloc.split(","):              # PostgreSQL allows host1,host2
        part = part.strip()
        if part.startswith("["):                # [ipv6]:port
            hosts.append(part[1:part.index("]")] if "]" in part else part[1:])
        else:
            hosts.append(part.rsplit(":", 1)[0] if ":" in part else part)
    return any(_host_is_loopback(h) for h in hosts) if hosts else True


def prod_env(cwd):
    """.env.production から DB URL 2種を取り、現在の環境に重ねて返す（.env の stale 値対策）。
    (env, "") か (None, 理由)。"""
    envfile = os.path.join(cwd, ".env.production")
    urls = {}
    try:
        with open(envfile, encoding="utf-8") as fh:
            for line in fh:
                m = re.match(r'^(DATABASE_URL|DATABASE_URL_UNPOOLED)=([\'"]?)(.*?)\2\s*$', line.strip())
                if m:
                    urls[m.group(1)] = m.group(3)
    except UnicodeDecodeError:
        return None, ".env.production が UTF-8 でない（解析不能 → 中止）"
    except OSError as e:
        return None, f".env.production を読めない: {e}"
    if "DATABASE_URL" not in urls or "DATABASE_URL_UNPOOLED" not in urls:
        return None, ".env.production に DATABASE_URL / DATABASE_URL_UNPOOLED が無い"
    for k, v in urls.items():
        if _url_is_loopback(v):
            return None, f"{k} が loopback/localhost を指している（本番 URL でない）→ 中止"
    env = dict(os.environ)
    env.update(urls)
    return env, ""


def deploy_migrations(cwd, env):
    """本番 DB へ pending migration を適用する（expand-contract 前提）。env は呼び出し側が
    prod_env で一度だけ取得したもの（status 検査と deploy が同じ DB を見るように共有する）。
    呼び出し側で作業ツリーを PR head SHA に checkout 済みであること（検査＝適用＝マージの一致）。"""
    host = re.sub(r"^.*@", "", env["DATABASE_URL_UNPOOLED"]).split("/")[0]
    log(f"本番 DB へ migration 適用: {host}")
    rc, out = run(["npx", "prisma", "migrate", "deploy"], cwd, timeout=600, env=env)
    if rc != 0:
        return False, f"migrate deploy 失敗: {relay.oneline(out, 300)}"
    rc, out = run(["npx", "prisma", "migrate", "status"], cwd, timeout=120, env=env)
    if not migrate_status_clean(rc, out):
        return False, f"migrate status が clean でない: {relay.oneline(out, 300)}"
    ok("migration 適用完了（migrate status clean）")
    return True, ""


# --- 1タスクの処理 ------------------------------------------------------------ #
def merge_phase(a, cwd):
    """relay 成功後: PR 特定 → CI green 待ち → (migration) → merge。(ok, note, reason)"""
    rc, branch = git(["branch", "--show-current"], cwd)
    branch = branch.strip()
    if rc != 0 or not branch or branch == "main":
        return False, "", f"PR 用ブランチが無い（current={branch or '?'}）— Claude が PR を作らなかった可能性"
    rc, out = gh_retry(["pr", "list", "--head", branch, "--state", "open",
                        "--json", "number,url", "--jq", ".[0].number, .[0].url"], cwd)
    lines = [l for l in out.strip().splitlines() if l]
    # PR が無い時 jq は "null" を返すため、数値であることまで確認する
    if rc != 0 or len(lines) < 2 or not lines[0].isdigit():
        return False, "", f"branch={branch} の open PR が見つからない: {relay.oneline(out)}"
    num, url = lines[0], lines[1]
    head = pr_head_sha(num, cwd)
    if not head:
        return False, "", f"PR #{num} の head SHA を取得できない（検査対象を固定できないため中止）"
    log(f"PR #{num}（head {head[:12]}）を検出 → CI (required checks) を待機（最大 {a.ci_timeout} 分）")
    rc, out = gh(["pr", "checks", num, "--watch", "--fail-fast", "--interval", "15"],
                 cwd, timeout=a.ci_timeout * 60)
    if rc != 0:
        return False, "", f"PR #{num} の CI が green にならない: {relay.oneline(out, 300)}"
    ok(f"PR #{num} CI green")
    if a.no_merge:
        return True, f"PR #{num} 作成（--no-merge のため未マージ） {url}", ""
    rc, out = gh_retry(["pr", "diff", num, "--name-only"], cwd, timeout=120)
    if rc != 0:
        return False, "", f"PR #{num} の差分ファイル一覧を取得できない: {relay.oneline(out)}"
    migs = [f for f in out.splitlines() if f.startswith("prisma/migrations/") and f.endswith(".sql")]
    if migs:
        log(f"PR #{num} は migration を含む → マージ前に本番へ適用する")
        # 検査・適用・マージを同じコミット（PR head）に固定する。先に head を作業ツリーへ
        # checkout してから、`migrate deploy` が実際に当てる pending 全件（PR 分 + 既存未適用）
        # を検査する。PR 差分だけの検査だと、main に残った破壊的 migration を見逃す。
        moved = pr_head_sha(num, cwd)
        if not moved:
            return False, "", f"PR #{num} 未マージのまま保留（本番 DB は未変更）。head 再確認に失敗（取得不可＝安全側で中止）"
        if moved != head:
            return False, "", f"PR #{num} 未マージのまま保留（本番 DB は未変更）。検査前に PR head が更新された（{head[:12]}→{moved[:12]}）"
        co_ok, co_err = checkout_detached(cwd, head)
        if not co_ok:
            return False, "", f"PR #{num} 未マージのまま保留（本番 DB は未変更）。head {head[:12]} を checkout できない: {co_err}"
        # DB URL は一度だけ取得し、pending 検査と deploy で同じ env を使う（別 DB を検査／適用しない）
        env, eerr = prod_env(cwd)
        if env is None:
            return False, "", f"PR #{num} 未マージのまま保留（本番 DB は未変更）。{eerr}"
        if a.allow_unsafe_migrations:
            warn("--allow-unsafe-migrations: migration allowlist 検査をスキップします")
        else:
            safe, why = screen_pending_migrations(cwd, env)
            if not safe:
                return False, "", f"PR #{num} 未マージのまま保留（本番 DB は未変更）。{why}"
            ok(f"migration allowlist 検査 OK（deploy 対象の pending 全件・head {head[:12]}）")
        good, err = deploy_migrations(cwd, env)
        if not good:
            return False, "", f"PR #{num} 未マージのまま保留。{err}"
    final = pr_head_sha(num, cwd)
    if not final:
        return False, "", (f"PR #{num} マージ中止（本番 DB は {'変更済み' if migs else '未変更'}）。"
                           f"マージ直前の head 再確認に失敗（取得不可＝安全側で中止）")
    if final != head:
        return False, "", (f"PR #{num} マージ中止（本番 DB は {'変更済み' if migs else '未変更'}）。"
                           f"マージ直前に PR head が更新された（{head[:12]}→{final[:12]}）— 検査/適用と別コミットをマージしないため保留")
    # merge は GitHub が 5xx を返してもサーバ側で成立していることがある（2026-07-20:
    # 504 Gateway Timeout だが実際は MERGED だった実例）。コマンドの成否に関わらず
    # 必ず実状態（pr view .state）で判定し、未成立なら間隔を空けて再試行する。
    merged = False
    foreign = False
    last_err = ""
    for attempt in range(3):
        if attempt:
            log(f"マージ再試行 {attempt + 1}/3（20秒待機後）")
            time.sleep(20)
        rc, out = gh(["pr", "merge", num, "--merge", "--match-head-commit", head], cwd, timeout=300)
        if rc != 0:
            last_err = relay.oneline(out, 200)
            log(f"merge コマンド失敗 → 実状態を確認します: {last_err[:120]}")
        for _ in range(10):
            # state だけでは「別 head が外部でマージされた MERGED」を成功と誤認する（--merge
            # なので PR の headRefOid はマージされたコミットのまま）。MERGED かつ
            # headRefOid == 我々が固定した head の時だけ成功、別 SHA は保留。
            _rc, st = gh(["pr", "view", num, "--json", "state,headRefOid",
                          "--jq", '.state + "\\t" + (.headRefOid // "")'], cwd)
            parts = st.strip().split("\t")
            if parts and parts[0] == "MERGED":
                if len(parts) > 1 and parts[1] == head:
                    merged = True
                else:
                    foreign = True          # a DIFFERENT commit was merged
                break
            time.sleep(6)
        if merged or foreign:
            break
    if foreign:
        return False, "", (f"PR #{num} マージ中止（本番 DB は {'変更済み' if migs else '未変更'}）。"
                           f"我々が固定した head（{head[:12]}）と異なるコミットが外部でマージされた — 保留")
    if not merged:
        return False, "", f"PR #{num} マージ失敗（3回試行・実状態も未成立）: {last_err}"
    ok(f"PR #{num} merged（head {head[:12]}）→ Vercel 本番デプロイが走ります")
    return True, f"PR #{num} merged {url}", ""


def run_task(a, panes, task, i, total):
    """1タスク実行。(status, note, reason) を返す。
    status: "ok"=完了 / "hold"=タスク固有の異常（[!] マークして次へ）/
            "fatal"=環境異常（タスクは [ ] に戻しキュー全体を停止。poke 不達等は
            どのタスクでも同じに失敗するため、続行はタスクを焼くだけ — 2026-07-20 実障害）"""
    good, err = to_main(a.dir)
    if not good:
        return "fatal", "", err

    # Claude がプラン承認ダイアログで停止中なら poke は届かない（ダイアログは入力を
    # 無エコーで食う）。この場合タスク注入はせず relay に委譲する — relay が
    # プランレビューフロー（Codex レビュー → 承認/修正要求）でダイアログを解決し、
    # そのまま実装 → PR まで進む。通常このダイアログは直前まで処理していた
    # 同じタスクのプランなので、注入スキップで正しい流れに乗る。
    dialog = relay.detect_plan_dialog(panes["claude"])
    if dialog:
        log("Claude はプラン承認待ちダイアログ表示中 → タスク注入をスキップし relay に委譲")
        if dialog.get("plan"):
            log(f"  plan: {dialog['plan']}")
    else:
        # poke を先、relay 起動を後にする: relay --adopt のピン留めを実働セッションに
        # 確定させるため（同 dir に複数 Claude セッションがあると誤ピンしうる）。
        if not relay.poke(panes["claude"], task_prompt(task, i, total)):
            return "fatal", "", "Claude ペインへタスクを配達できない（poke 失敗）— ペインの状態を確認してください"
        time.sleep(5)

    cmd = [RELAY, "--adopt", "--session", a.session, "--dir", a.dir,
           "--max-rounds", str(a.rounds)]
    if a.stop:
        cmd += ["--stop", a.stop]
    proc = subprocess.Popen(cmd)
    time.sleep(4)
    if proc.poll() is not None:
        return "fatal", "", f"relay が即死した（exit={proc.returncode}）。ペア構成を確認"

    try:
        rc = proc.wait(timeout=a.task_timeout * 60)
    except subprocess.TimeoutExpired:
        proc.send_signal(signal.SIGINT)
        try:
            proc.wait(timeout=15)
        except subprocess.TimeoutExpired:
            proc.kill()
        return "hold", "", f"タスクが {a.task_timeout} 分で完了せずタイムアウト"

    if rc != 0:
        return "hold", "", f"relay 異常終了: {RELAY_EXIT.get(rc, f'exit={rc}')}"
    ok_, note, reason = merge_phase(a, a.dir)
    return ("ok", note, "") if ok_ else ("hold", "", reason)


# --------------------------------------------------------------------------- #
def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("queue", nargs="?", help="キューファイル（既定: <dir>/tasks/queue.md）")
    ap.add_argument("--dir", default=os.getcwd())
    ap.add_argument("--session", help="tmux session（既定: 現在）")
    ap.add_argument("--max-tasks", type=int, default=0, help="今回処理する最大件数（0=キューが尽きるまで）")
    ap.add_argument("--rounds", type=int, default=20, help="relay の最大往復（既定20）")
    ap.add_argument("--stop", default=None, help="relay の停止ワード（既定は relay 側既定）")
    ap.add_argument("--task-timeout", type=int, default=120, help="1タスクの上限（分、既定120）")
    ap.add_argument("--ci-timeout", type=int, default=30, help="CI 待ちの上限（分、既定30）")
    ap.add_argument("--max-consecutive-failures", type=int, default=3,
                    help="連続異常がこの回数に達したらキュー全体を停止（既定3）")
    ap.add_argument("--no-merge", action="store_true", help="PR 作成まで（マージしない）")
    ap.add_argument("--allow-unsafe-migrations", action="store_true",
                    help="migration allowlist 検査をスキップ（手動レビュー済みの時のみ）")
    ap.add_argument("--dry-run", action="store_true", help="実行せず構成と先頭タスクを表示")
    a = ap.parse_args()

    a.dir = os.path.realpath(os.path.expanduser(a.dir))
    qpath = os.path.realpath(a.queue) if a.queue else os.path.join(a.dir, "tasks", "queue.md")
    a.session = a.session or relay.current_session()
    if not a.session:
        print(c("warn", "aipair-queue: tmux 外です（--session 指定か bridge ペインで実行）"), file=sys.stderr)
        return 2
    panes = relay.find_panes(a.session)
    if "claude" not in panes or "codex" not in panes:
        print(c("warn", f"claude+codex ペインが見つからない（session={a.session}, found={panes}）"),
              file=sys.stderr)
        return 2
    if not os.path.exists(qpath):
        print(c("warn", f"キューファイルが無い: {qpath}"), file=sys.stderr)
        return 2

    print(c("relay", "┏━ aipair-queue ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"))
    log(f"session={a.session}  dir={a.dir}")
    log(f"queue={qpath}（残 {remaining(qpath)} 件）  panes={panes['claude']}/{panes['codex']}")
    log(f"マージ={'しない (--no-merge)' if a.no_merge else '全自動（migration は本番適用してからマージ）'}"
        f"  異常時=スキップして次へ（連続 {a.max_consecutive_failures} 回で全体停止）")
    print(c("relay", "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"))

    if a.dry_run:
        line, task = next_task(qpath)
        log("dry-run: 先頭タスク = " + (relay.oneline(task) if task else "（なし）"))
        if task:
            log("dry-run: 注入プロンプト:")
            print(task_prompt(task, 1, remaining(qpath)))
        rc, out = git(["status", "--porcelain", "-uno"], a.dir)
        log(f"dry-run: git dirty(tracked) = {bool(out.strip())} / branch = "
            f"{git(['branch', '--show-current'], a.dir)[1].strip()}")
        return 0

    # untracked は判定に含めない（.vscode/ や _reference/ 等の常駐 untracked が
    # あるのが通常状態のため）。tracked の変更 = 誰かの WIP がある時だけ止める。
    rc, out = git(["status", "--porcelain", "-uno"], a.dir)
    if out.strip():
        warn("作業ツリーに未コミットの変更（tracked）がある。人間の WIP を巻き込まないため開始を中止します。")
        print(out)
        return 2

    merged, held = [], []
    consecutive = 0
    n = 0
    try:
        while True:
            if a.max_tasks and n >= a.max_tasks:
                log(f"--max-tasks {a.max_tasks} に到達。終了します。")
                break
            line, task = next_task(qpath)
            if not task:
                log("キューが空になりました。")
                break
            n += 1
            total = remaining(qpath) + n - 1
            log("")
            log(c("ok", f"◆ task {n}: ") + relay.oneline(task))
            rewrite_line(qpath, line, f"- [>] {task}")
            status, note, reason = run_task(a, panes, task, n, total)
            if status == "ok":
                rewrite_line(qpath, f"- [>] {task}", f"- [x] {task} — {note}")
                merged.append((task, note))
                consecutive = 0
                ok(f"task {n} 完了: {note}")
            elif status == "fatal":
                # 環境異常: タスクに責任は無いので [ ] に戻し、キュー全体を止める
                rewrite_line(qpath, f"- [>] {task}", f"- [ ] {task}")
                warn(f"環境異常のためキューを停止します: {reason}")
                warn("解消後にもう一度 aipair-queue を実行してください（タスクは未消費のまま）。")
                break
            else:  # hold
                stash_if_dirty(a.dir, f"task{n} aborted")
                to_main(a.dir)
                rewrite_line(qpath, f"- [>] {task}", f"- [!] {task} — 要人間: {reason}")
                held.append((task, reason))
                consecutive += 1
                warn(f"task {n} を保留: {reason}")
                if consecutive >= a.max_consecutive_failures:
                    warn(f"連続 {consecutive} 回異常 → 同一原因の空回りとみなしキューを停止します。")
                    break
    except KeyboardInterrupt:
        print()
        warn("中断しました。処理中タスクは queue.md の [>] を確認してください。")

    print(c("relay", "┏━ サマリ ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"))
    log(f"マージ {len(merged)} 件 / 保留 {len(held)} 件 / キュー残 {remaining(qpath)} 件")
    for t, note in merged:
        log("  " + c("ok", "✔ ") + relay.oneline(t, 80) + f" — {note}")
    for t, reason in held:
        log("  " + c("warn", "! ") + relay.oneline(t, 80) + f" — {reason}")
    print(c("relay", "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"))
    print("\a", end="", flush=True)
    return 0 if not held else 1


if __name__ == "__main__":
    sys.exit(main())
