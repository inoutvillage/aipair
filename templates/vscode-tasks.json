{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🤝【AI Pair】起動 / 再アタッチ（claude ┃ codex ／ 下段 bridge）",
      "type": "shell",
      "command": "wsl.exe",
      "args": [
        "--cd", "${workspaceFolder}",
        "bash", "-ic", "aipair"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "🔁【AI Pair】相互レビュー・ループ（自走 / Codexが [AIPAIR_REVIEW_OK] で停止）",
      "type": "shell",
      "command": "wsl.exe",
      "args": [
        "--cd", "${workspaceFolder}",
        "bash", "-ic", "aipair loop --unsafe"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "⚡【AI Pair】relay 強制再点火（endless / max100 / 版無視）",
      "type": "shell",
      "command": "wsl.exe",
      "args": [
        "--cd", "${workspaceFolder}",
        "bash", "-ic", "aipair-relay-here --endless --max-rounds 100 --allow-untested-dialogs"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🔄【AI Pair】relay 再点火（非endless / プラン+質問ON・版無視）",
      "type": "shell",
      "command": "wsl.exe",
      "args": [
        "--cd", "${workspaceFolder}",
        "bash", "-ic", "aipair-relay-here --no-endless --allow-untested-dialogs"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "📜【AI Pair】統合ログ（bridge）だけ表示",
      "type": "shell",
      "command": "wsl.exe",
      "args": [
        "--cd", "${workspaceFolder}",
        "bash", "-ic", "peer-log both --watch"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "🛑【AI Pair】停止（tmux セッション kill）",
      "type": "shell",
      "command": "wsl.exe",
      "args": [
        "--cd", "${workspaceFolder}",
        "bash", "-ic", "aipair stop"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "🤖 claude 単体起動（peer 参照可）",
      "type": "shell",
      "command": "wsl.exe",
      "args": [
        "--cd", "${workspaceFolder}",
        "bash", "-ic", "export AI_SELF=claude AI_PEER=codex && claude"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "agents"
      },
      "problemMatcher": []
    },
    {
      "label": "🤖 codex 単体起動（peer 参照可）",
      "type": "shell",
      "command": "wsl.exe",
      "args": [
        "--cd", "${workspaceFolder}",
        "bash", "-ic", "export AI_SELF=codex AI_PEER=claude && codex"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "agents"
      },
      "problemMatcher": []
    }
  ]
}
